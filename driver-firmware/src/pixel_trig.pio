; Trigger qualification, and the interval measurement that goes with it.
;
; One FIFO word per accepted trigger, same as before. What changed is the
; CONTENTS of that word. It used to be "in pins, 1", one bit sampled from a
; line that is low at that instant, so every word was an identical zero and
; the CPU threw it away. The CPU then read micros() itself to work out when
; the trigger happened, which is only correct if the CPU was waiting for it.
; If the word had been sitting in the FIFO while the CPU was busy - a USB
; interrupt, a long Serial write - the timestamp was late by an unknown
; amount, and a whole heuristic existed in runScan() to guess whether to
; believe it.
;
; The word now carries the number of loop passes the state machine spent
; waiting for this edge. Two cycles per pass, so 13.33 ns per count at
; 150 MHz. The CPU adds the known refractory window to get the true interval
; between accepted triggers. Nothing the CPU does can distort it, because it
; was counted before the CPU ever saw the word.
;
; The host supplies the refractory period in cycles before the machine starts.
.program pixel_trig
.wrap_target
top:
    pull noblock            ; OSR <- X when TX is empty, so X survives forever
    mov x, osr              ; X = refractory window, in cycles

    mov y, ~null            ; Y = 0xFFFFFFFF, counts DOWN once per pass

; The line must be seen high before a low can be accepted. Without this, a low
; region that outlasts the refractory window would be read as a fresh edge the
; moment the window expires. Both loops below are 2 cycles per pass, so Y
; counts in the same units either way.
arm:
    jmp pin watch           ; high: the line is armed, now watch for the fall
    jmp y-- arm             ; still low: count and look again

watch:
    jmp pin keep            ; still high: count and look again
    jmp fell                ; fell: this is the accepted trigger
keep:
    jmp y-- watch

fell:
    mov isr, ~y             ; ~Y = number of passes waited
    push noblock            ; one word per trigger, carrying the interval

    mov y, x
refractory:
    jmp y-- refractory      ; blackout. The pin is not read at all in here,
                            ; so bounce inside the window is never observed
                            ; rather than rejected after the fact.
.wrap

; Diagnostic edge counter, no filtering of any kind. Every low-then-high
; transition pushes a word, bounce included. Comparing its count against the
; debounced count is the only measure of how dirty the trigger line is, so it
; deliberately has no policy in it. Leave it alone.
.program raw_edge_count
.wrap_target
    wait 0 pin 0
    in pins, 1
    push noblock
    wait 1 pin 0
.wrap
